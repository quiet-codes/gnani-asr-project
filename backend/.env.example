# Create a local PostgreSQL database named gnani_asr, then update credentials here.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/gnani_asr

# Gnani Prisma v2.5 API key sent as X-API-Key-ID. Never commit a real key.
GNANI_API_KEY=replace-with-your-gnani-api-key

# Comma-separated exact browser origins. Add your Vercel production URL when deployed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The frontend uses a 100 MB limit; file bytes are checked independently of the provider's duration limit.
MAX_UPLOAD_SIZE_MB=100
GNANI_TIMEOUT_SECONDS=75
